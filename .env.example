# =============================================================================
# Frame — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit real secrets. Validate at runtime via src/lib/env.ts.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# Project Settings → API in the Supabase dashboard
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the client.
# Used for privileged admin operations (if any). Prefer RLS for user data.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Frame

# -----------------------------------------------------------------------------
# TMDB — The Movie Database (Phase 2 catalog)
# Create an API key at https://www.themoviedb.org/settings/api
# Provide either TMDB_API_KEY (v3) or TMDB_READ_ACCESS_TOKEN (v4 bearer).
# -----------------------------------------------------------------------------
TMDB_API_KEY=your-tmdb-v3-api-key
# TMDB_READ_ACCESS_TOKEN=your-tmdb-v4-read-access-token

# -----------------------------------------------------------------------------
# Optional: analytics / monitoring
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=

# -----------------------------------------------------------------------------
# OMDb � IMDb, Rotten Tomatoes, Metacritic ratings
# Free key: https://www.omdbapi.com/apikey.aspx
# -----------------------------------------------------------------------------
OMDB_API_KEY=your-omdb-api-key

# -----------------------------------------------------------------------------
# Streaming region for "Where to watch" (TMDB / JustWatch)
# ISO country code: US, IN, GB, CA, AU, ...
# -----------------------------------------------------------------------------
WATCH_REGION=US